# Lovioa — Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI-compatible API base URL (server-side)
OPENAI_API_BASE_URL=https://api.openai.com/v1

# API key for image generation (server-side)
OPENAI_API_KEY=

# Legacy variable names are accepted for local compatibility only.
# Do not expose secret values through VITE_* variables in frontend builds.
VITE_OPENAI_API_BASE_URL=

# Optional per-model API keys for providers sharing the same OpenAI-compatible base URL.
# Example: {"gemini-3-pro-image":"your-model-api-key","gemini-3.1-flash-image":"your-model-api-key"}
OPENAI_IMAGE_MODEL_KEYS={}

# Optional accelerated generation route
# Routing default: `quality=hd` -> fast, `quality=standard` -> slow
GEN_FAST_API_BASE_URL=
GEN_FAST_API_BASE_URL_CN=
GEN_FAST_API_PATH=/v1/api/generate
# Optional async result endpoint if fast API returns task id first
GEN_FAST_RESULT_PATH=/v1/api/result
GEN_FAST_API_KEY=
GEN_FAST_REPLY_TYPE=json
# Optional comma-separated routing matchers
GEN_FAST_MODELS=
GEN_FAST_QUALITIES=hd
# true = force all generation requests to the accelerated route
GEN_FORCE_FAST_FOR_ALL=false

# Defaults used by Generate Modal
VITE_OPENAI_IMAGE_MODEL=gpt-image-2
VITE_OPENAI_IMAGE_SIZE=1024x1024

# Password reset email (Resend)
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Google Sign-In (backend token verification)
GOOGLE_CLIENT_ID=
# Google Sign-In (frontend Google button rendering)
VITE_GOOGLE_CLIENT_ID=

# Optional: synchronize generated content with another deployment
REMOTE_SYNC_ENABLED=false
REMOTE_SYNC_BASE_URL=
# Optional identity value used by the receiving deployment
REMOTE_SYNC_USER_ID=
# Shared secret for authenticated synchronization
REMOTE_SYNC_SECRET=
REMOTE_SYNC_POLL_MS=12000
REMOTE_SYNC_BATCH_SIZE=2

# S3-compatible object storage
# Uploads and generated images go here. Keep provider-specific values local.
S4_ENDPOINT=
S4_ACCESS_KEY=
S4_SECRET_KEY=
S4_BUCKET_NAME=
# Optional: custom public domain for CDN URLs
# S4_PUBLIC_DOMAIN=https://cdn.example.com

# Optional legacy/public asset URL migration
LEGACY_ASSET_PREFIX=
PUBLIC_ASSET_PREFIX=
LEGACY_BLOCKED_IMAGE_HOSTS=

# Legacy: Cloudflare R2 (use instead of S4 if preferred)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=lovioa-assets
# R2_PUBLIC_DOMAIN=

# Creem webhook secret (find it in your Creem Dashboard → API & Webhooks)
CREEM_WEBHOOK_SECRET=
# Creem Moderation API key (required for AI image/video generation compliance)
# CREEM_API_KEY=
# Optional override for Creem API base URL
# CREEM_API_BASE_URL=https://api.creem.io
# CREEM_MODERATION_TIMEOUT_MS=8000
# Set to false only for local dev/debug. Production should keep true.
# CREEM_MODERATION_REQUIRED=true

# Optional: Creem hosted checkout links (fallback when Stripe is not configured)
# CREEM_CHECKOUT_ESSENTIAL_MONTHLY=
# CREEM_CHECKOUT_ESSENTIAL_YEARLY=
# CREEM_CHECKOUT_PREMIUM_MONTHLY=
# CREEM_CHECKOUT_PREMIUM_YEARLY=
# CREEM_CHECKOUT_PRO_MONTHLY=
# CREEM_CHECKOUT_PRO_YEARLY=

# DeepSeek tagging (OpenAI-compatible chat completions)
# Used by: /api/admin/tags/backfill and server/scripts/llmTagBackfill.js
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TAG_MODEL=deepseek-chat
