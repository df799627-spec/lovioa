{
  "name": "lovioa-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Lovioa",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "tag:backfill:dry": "node scripts/llmTagBackfill.js --limit=100 --batch=10 --concurrency=10 --dry-run",
    "tag:backfill:apply": "node scripts/llmTagBackfill.js --limit=100 --batch=10 --concurrency=10 --apply",
    "heartbeat:category-backfill": "node scripts/heartbeatCategoryBackfill.js --batch=120 --target=160 --categories=8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/lib-storage": "^3.1051.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.6.2",
    "multer": "^1.4.5-lts.1",
    "stripe": "^22.1.1",
    "uuid": "^10.0.0"
  }
}
