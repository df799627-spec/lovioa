# ─── Cloudflare R2 (图片存储 + CDN) ───────────────────────────────────────────
#
# 创建方式:
# 1. 登录 Cloudflare Dashboard → R2 → Create bucket (名称如: lovioa-assets)
# 2. 在 R2 bucket 设置 Public access 或绑定 Custom Domain
#    (如 cdn.example.com → CNAME cdn.cloudflare.net → bucket)
# 3. 在 Cloudflare API Tokens 页面创建 Token:
#    Account permissions: Object Workers > Edit
#    Bucket permissions: Object Read + Write for lovioa-assets
# 4. 把 Account ID (在 Cloudflare Dashboard 右下角) 和 Token 信息填到下面

R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=lovioa-assets

# 可选: 自定义 CDN 域名（留空则使用 R2.dev 默认 URL）
# 必须先在 Cloudflare Dashboard 将此域名绑定到 R2 bucket
R2_PUBLIC_DOMAIN=https://cdn.example.com

# ─── 数据库 ────────────────────────────────────────────────────────────────────
# 默认使用 server/data/lovioa.db (SQLite)，无需配置

# ─── Image generation ─────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE_URL=https://api.openai.com/v1
NANO_IMAGE_PROXY_URL=https://home.code2alita.com/api/playground/image
NANO_IMAGE_MODEL_MAP={"gemini-3-pro-image":"gpt-image-gemini-3-pro-image","gemini-3.1-flash-image":"gpt-image-gemini-3.1-flash-image","image-gemini-3-pro-image":"gpt-image-gemini-3-pro-image"}
# Legacy variable names are accepted for local compatibility only.
VITE_OPENAI_API_BASE_URL=
VITE_OPENAI_IMAGE_MODEL=gpt-image-2
VITE_OPENAI_IMAGE_SIZE=1024x1024
GEN_DEFAULT_QUALITY=medium

# ─── Prompt text model ───────────────────────────────────────────────────────
PROMPT_TEXT_API_KEY=
PROMPT_TEXT_BASE_URL=https://d1api.xin/v1
PROMPT_TEXT_MODEL=deepseek-v4.1-flash

# ─── 站点 ──────────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=http://localhost:3001
SELF_URL=http://localhost:3001
VITE_SITE_URL=https://your-domain.example

# ─── 生成队列 Worker ───────────────────────────────────────────────────────────
GEN_QUEUE_WORKERS=2
GEN_QUEUE_CONCURRENCY=3

# ─── Stripe Billing (可选) ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# CREEM_WEBHOOK_SECRET=your_creem_secret
# Optional: Creem hosted checkout links (used automatically when Stripe is not configured)
# CREEM_CHECKOUT_ESSENTIAL_MONTHLY=https://...
# CREEM_CHECKOUT_ESSENTIAL_YEARLY=https://...
# CREEM_CHECKOUT_PREMIUM_MONTHLY=https://...
# CREEM_CHECKOUT_PREMIUM_YEARLY=https://...
# CREEM_CHECKOUT_PRO_MONTHLY=https://...
# CREEM_CHECKOUT_PRO_YEARLY=https://...

# ─── 跨部署同步（可选） ────────────────────────────────────────────────────────
# REMOTE_SYNC_ENABLED=false
# REMOTE_SYNC_BASE_URL=https://your-deployment.example
# REMOTE_SYNC_USER_ID=receiving_deployment_user_id
# REMOTE_SYNC_POLL_MS=12000
# REMOTE_SYNC_BATCH_SIZE=2

# Optional cleanup for legacy external image hosts
# LEGACY_BLOCKED_IMAGE_HOSTS=

# ─── 密码重置 (可选) ──────────────────────────────────────────────────────────
# SMTP settings for password reset emails
# PASSWORD_RESET_TTL_MINUTES=30
